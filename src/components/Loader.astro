---
/**
 * Açılış perdesi — kendi kendini çizen sekiz köşeli yıldız.
 *
 * ÜÇ KURAL:
 *  · Yalnızca oturumdaki ilk ziyarette (sessionStorage). Her sayfa
 *    geçişinde tekrarlanan bir animasyon, üçüncü seferde engel oluyor.
 *  · İçeriği ENGELLEMİYOR: perde üstte duruyor, altında sayfa zaten
 *    yüklenmiş. JS kapalıysa hiç görünmüyor (başlangıçta gizli).
 *  · `prefers-reduced-motion` açıkken hiç çalışmıyor.
 */
const r = 50;
const ic = r * 0.414 * Math.SQRT2;
const nokta = Array.from({ length: 16 }, (_, i) => {
  const aci = (Math.PI / 8) * i - Math.PI / 2;
  const yc = i % 2 === 0 ? r : ic;
  return `${(60 + yc * Math.cos(aci)).toFixed(2)},${(60 + yc * Math.sin(aci)).toFixed(2)}`;
}).join(" ");
---

<div id="perde" class="perde" hidden aria-hidden="true">
  <svg viewBox="0 0 120 120" width="112" height="112">
    <polygon
      class="yildiz"
      points={nokta}
      fill="none"
      stroke="var(--bakir)"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <circle class="halka" cx="60" cy="60" r="18" fill="none" stroke="var(--varak)" stroke-width="1" />
  </svg>
</div>

<script is:inline>
  (function () {
    var perde = document.getElementById("perde");
    if (!perde) return;
    var azHareket = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var gosterildi = false;
    try {
      gosterildi = sessionStorage.getItem("mt-perde") === "1";
    } catch (e) {
      /* Gizli sekmede depolama kapalı olabiliyor; o zaman perde yine çalışır. */
    }
    if (azHareket || gosterildi) return;

    perde.hidden = false;
    document.documentElement.classList.add("perde-acik");
    try {
      sessionStorage.setItem("mt-perde", "1");
    } catch (e) {}

    window.setTimeout(function () {
      perde.classList.add("kalk");
      document.documentElement.classList.remove("perde-acik");
      window.setTimeout(function () {
        perde.hidden = true;
      }, 600);
    }, 1050);
  })();
</script>

<style>
  .perde {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--kagit);
    transition:
      transform 0.6s cubic-bezier(0.7, 0, 0.3, 1),
      opacity 0.6s ease;
  }
  .perde.kalk {
    transform: translateY(-100%);
    opacity: 0;
  }
  .yildiz {
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
    animation: ciz 0.75s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .halka {
    opacity: 0;
    transform-origin: 60px 60px;
    animation: ac 0.45s ease 0.55s forwards;
  }
  @keyframes ciz {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes ac {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 0.9;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .perde {
      display: none;
    }
  }
</style>
