---
/**
 * Balkan kilim bordürü — footer üstünde ve sayfa kenarlarında ince şerit.
 *
 * Baklava–kanca deseni tekrar ediyor (Bosna/Pirot kilimi esinli). Desen
 * `pattern` ile döşeniyor; genişlik ne olursa olsun tekrar kesintisiz.
 */
interface Props {
  class?: string;
  yukseklik?: number;
}
const { class: sinif = "", yukseklik = 12 } = Astro.props;
const kimlik = `kilim-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={sinif}
  height={yukseklik}
  width="100%"
  viewBox="0 0 48 12"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern id={kimlik} width="24" height="12" patternUnits="userSpaceOnUse">
      <path d="M0 6 L6 0 L12 6 L6 12 Z" fill="var(--bakir)" opacity="0.85" />
      <path d="M12 6 L18 0 L24 6 L18 12 Z" fill="none" stroke="var(--nar)" stroke-width="1" />
      <path d="M6 6 L6 6" />
      <path d="M0 0 H24" stroke="var(--varak)" stroke-width="0.5" opacity="0.6" />
      <path d="M0 12 H24" stroke="var(--varak)" stroke-width="0.5" opacity="0.6" />
    </pattern>
  </defs>
  <rect width="48" height="12" fill={`url(#${kimlik})`} />
</svg>
