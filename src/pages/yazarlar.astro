---
import Taban from "../layouts/Taban.astro";
import Kapak from "../components/Kapak.astro";
import Yildiz8 from "../components/motifs/Yildiz8.astro";
import { ROL_ADLARI, sonYil, tumEserler, yazaraGore } from "../lib/books";

const eserler = await tumEserler();
const yazarlar = yazaraGore(eserler);
const telif = eserler.filter((e) => !e.originalAuthor);
---

<Taban
  baslik="Çevrilen yazarlar"
  aciklama={`Muharrem Tan'ın Türkçeye kazandırdığı ${yazarlar.length} yazar: Ebû Tâlib el-Mekkî'den Tevfîk el-Hakîm'e, klasikten çağdaşa.`}
>
  <section class="kapsa bas">
    <p class="etiket">Kimler</p>
    <h1>Çevrilen yazarlar</h1>
    <p class="ozet">
      Dördüncü yüzyılın tasavvuf müellifinden yirminci yüzyılın romancısına,
      {yazarlar.length} yazarın eseri bu çevirilerle Türkçede okunuyor.
    </p>
  </section>

  <section class="kapsa liste">
    {yazarlar.map((y) => (
      <article class="yazar" id={y.kimlik}>
        <header class="yazar-bas">
          <Yildiz8 boyut={16} kalinlik={1.5} class="yildiz" />
          <div>
            <h2>{y.ad}</h2>
            <p class="adet">{y.eserler.length} eser</p>
          </div>
        </header>
        <div class="kitaplar">
          {y.eserler.map((e) => (
            <a href={`/eserler/${e.slug}/`} class="kitap">
              <Kapak eser={e} genislik={118} />
              <span class="ad">{e.title}</span>
              <span class="kunye">{ROL_ADLARI[e.role]}{sonYil(e) ? ` · ${sonYil(e)}` : ""}</span>
            </a>
          ))}
        </div>
      </article>
    ))}

    {
      telif.length ? (
        <article class="yazar" id="muharrem-tan">
          <header class="yazar-bas">
            <Yildiz8 boyut={16} kalinlik={1.5} dolu={true} class="yildiz" />
            <div>
              <h2>Muharrem Tan</h2>
              <p class="adet">{telif.length} telif, derleme ve editörlük çalışması</p>
            </div>
          </header>
          <div class="kitaplar">
            {telif.map((e) => (
              <a href={`/eserler/${e.slug}/`} class="kitap">
                <Kapak eser={e} genislik={118} />
                <span class="ad">{e.title}</span>
                <span class="kunye">{ROL_ADLARI[e.role]}{sonYil(e) ? ` · ${sonYil(e)}` : ""}</span>
              </a>
            ))}
          </div>
        </article>
      ) : null
    }
  </section>
</Taban>

<style>
  .bas { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .bas h1 { font-size: clamp(2.3rem, 6vw, 3.5rem); margin: 0.35rem 0 0.7rem; }
  .ozet { max-width: 55ch; color: var(--sessiz); margin: 0; }

  .liste { padding-block: 2rem 3rem; display: flex; flex-direction: column; gap: 3rem; }
  .yazar { scroll-margin-top: 6rem; }
  .yazar-bas {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding-bottom: 0.6rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--kenar);
  }
  .yildiz { color: var(--varak); flex: none; }
  .yazar h2 { font-size: clamp(1.35rem, 3vw, 1.75rem); }
  .adet {
    margin: 0.1rem 0 0;
    font-family: var(--font-arayuz);
    font-size: 0.74rem;
    color: var(--sessiz);
  }
  .kitaplar {
    display: grid;
    gap: 1.75rem 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 118px), 1fr));
  }
  .kitap { display: flex; flex-direction: column; gap: 0.4rem; }
  .kitap :global(svg),
  .kitap :global(img) {
    transition: transform 0.3s ease;
    box-shadow: 0 6px 16px -10px color-mix(in srgb, var(--murekkep) 60%, transparent);
  }
  .kitap:hover :global(svg),
  .kitap:hover :global(img) { transform: translateY(-4px); }
  .ad { font-family: var(--font-baslik); font-size: 0.95rem; line-height: 1.2; }
  .kitap:hover .ad { color: var(--bakir); }
  .kunye { font-family: var(--font-arayuz); font-size: 0.68rem; color: var(--sessiz); }
</style>
